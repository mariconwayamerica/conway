<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 5 PM EST = 22:00 UTC -->
    <record id="ir_cron_auto_send_po" model="ir.cron">
        <field name="name">Auto Send PO by Customer</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_po_by_customer()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="nextcall" eval="(datetime.now().replace(hour=22, minute=0, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
