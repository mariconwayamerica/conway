<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="invoice_vendor_bill_report_view_list" model="ir.ui.view">
        <field name="name">invoice.vendor.bill.report.list</field>
        <field name="model">invoice.vendor.bill.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="invoice_date"/>
                <field name="partner_id"/>
                <field name="x_original_customer_po_number"/>
                <field name="amount_total" sum="Total"/>
                <field name="payment_state" widget="badge" optional="show"/>
                <field name="sale_order_id"/>
                <field name="purchase_order_ids" widget="many2many_tags"/>
                <field name="vendor_id" optional="show"/>
                <field name="vendor_bill_ids" widget="many2many_tags"/>
                <field name="state" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="invoice_vendor_bill_report_view_form" model="ir.ui.view">
        <field name="name">invoice.vendor.bill.report.form</field>
        <field name="model">invoice.vendor.bill.report</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_invoice" type="object" string="Open Invoice" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Invoice">
                            <field name="invoice_id"/>
                            <field name="invoice_date"/>
                            <field name="partner_id"/>
                            <field name="x_original_customer_po_number"/>
                            <field name="amount_total"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="payment_state"/>
                        </group>
                        <group string="Purchasing">
                            <field name="sale_order_id"/>
                            <field name="purchase_order_ids" widget="many2many_tags"/>
                            <field name="vendor_id"/>
                        </group>
                    </group>
                    <separator string="Vendor Bills"/>
                    <field name="vendor_bill_ids">
                        <list>
                            <field name="name"/>
                            <field name="partner_id" string="Vendor"/>
                            <field name="invoice_date" string="Bill Date"/>
                            <field name="ref" string="Bill Reference"/>
                            <field name="amount_total"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="payment_state" widget="badge"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="invoice_vendor_bill_report_view_search" model="ir.ui.view">
        <field name="name">invoice.vendor.bill.report.search</field>
        <field name="model">invoice.vendor.bill.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="x_original_customer_po_number"/>
                <filter string="Posted" name="posted" domain="[('state', '=', 'posted')]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter string="Invoice Date" name="filter_invoice_date" date="invoice_date"/>
                <group>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Invoice Month" name="group_invoice_month" context="{'group_by': 'invoice_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_invoice_vendor_bill_report" model="ir.actions.act_window">
        <field name="name">Invoice and Vendor Bill</field>
        <field name="res_model">invoice.vendor.bill.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="invoice_vendor_bill_report_view_search"/>
        <field name="context">{'search_default_posted': 1}</field>
    </record>

    <!-- Last item under Accounting > Reporting > Statement Reports -->
    <menuitem id="menu_invoice_vendor_bill_report"
              name="Invoice and Vendor Bill"
              parent="account.account_reports_legal_statements_menu"
              action="action_invoice_vendor_bill_report"
              sequence="1000"/>
</odoo>
