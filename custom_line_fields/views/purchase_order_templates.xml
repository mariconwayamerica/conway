<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_purchase_order_custom_line_fields"
              inherit_id="purchase.purchase_order_portal_content">

        <!-- Add column headers -->
        <xpath expr="//th[hasclass('text-start')]" position="after">
            <th class="text-start">Factory Style #</th>
            <th class="text-start">Item Display Name</th>
            <th class="text-start">UPC</th>
            <th class="text-start">Color Code</th>
            <th class="text-start">Brand</th>
            <th class="text-start">Collection</th>
            <th class="text-start">Towel Type</th>
            <th class="text-start">Sales Description</th>
            <th class="text-start">General Notes</th>
        </xpath>

        <!-- Add column data cells -->
        <xpath expr="//td[@id='product_name']" position="after">
            <td><span t-esc="line.x_factory_style_number or ''"/></td>
            <td><span t-esc="line.x_item_display_name or ''"/></td>
            <td><span t-esc="line.x_item_upc or ''"/></td>
            <td><span t-esc="line.x_color_code or ''"/></td>
            <td><span t-esc="line.x_brand or ''"/></td>
            <td><span t-esc="line.x_collection or ''"/></td>
            <td><span t-esc="line.x_towel_type or ''"/></td>
            <td><span t-esc="line.x_sales_description or ''"/></td>
            <td><span t-esc="line.x_general_notes or ''"/></td>
        </xpath>

        <!-- Hide product image -->
        <xpath expr="//td[@id='product_name']//img" position="replace"><t/></xpath>

        <!-- Hide Taxes column header -->
        <xpath expr="//th[span[normalize-space()='Taxes']]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <!-- Hide Taxes column data cells -->
        <xpath expr="//td[span[@t-out]]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <!-- Hide Disc.% column header -->
        <xpath expr="//th[normalize-space(text())='Disc.%']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <!-- Hide Disc.% column data cells -->
        <xpath expr="//td[div[@t-field='line.discount']]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

    </template>
</odoo>
