<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_confirm_rfq" model="ir.cron">
        <field name="name">Auto Confirm Purchase RFQs</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_confirm_rfq()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
        <field name="nextcall" eval="(datetime.now().replace(minute=0, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
